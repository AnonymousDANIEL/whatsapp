FROM node:22-bookworm-slim
ENV NODE_ENV=production PUPPETEER_SKIP_DOWNLOAD=true SERVICE_ROLE=worker DATA_DIR=/data
RUN apt-get update && apt-get install -y --no-install-recommends chromium xvfb x11vnc xauth util-linux passwd tini fonts-noto-cjk fonts-noto-color-emoji ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY vendor ./vendor
RUN npm ci --omit=dev
COPY src ./src
COPY bin ./bin
RUN chmod 755 /app/bin/browser
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "src/main.js"]
