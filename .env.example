# Copy locally to .env; never commit .env. Railway variables go in each service's Variables tab.
SERVICE_ROLE=api
PORT=3000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/whatsapp
INTERNAL_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_URL=http://localhost:3000
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
WORKER_ROUTES_JSON={"group-a":"http://worker-a:8080","group-b":"http://worker-b:8080","group-c":"http://worker-c:8080","group-d":"http://worker-d:8080"}
TRUST_PROXY_HOPS=1
# Worker services instead use SERVICE_ROLE=worker, PORT=8080 and a unique group:
# WORKER_GROUP=group-a
# DATA_DIR=/data
# MAX_ACCOUNTS_PER_WORKER=5
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=90
# RAILWAY_RUN_UID=0
